    {
      "parameters": {
        "jsCode": "const lead = $input.first().json;\n\nconst HIGH_VALUE_INDUSTRIES = ['fintech', 'saas', 'enterprise software', 'banking', 'insurance'];\nconst MED_VALUE_INDUSTRIES  = ['retail', 'logistics', 'healthcare', 'education'];\n\nlet score = 0;\nconst reasons = [];\n\n// Company size score\nif (lead.companySize > 200) {\n  score += 40;\n  reasons.push('large company (+40)');\n} else if (lead.companySize > 50) {\n  score += 25;\n  reasons.push('mid-size company (+25)');\n} else if (lead.companySize > 10) {\n  score += 10;\n  reasons.push('small company (+10)');\n} else {\n  reasons.push('micro/unknown size (+0)');\n}\n\n// Industry score\nconst industryLower = (lead.industry || '').toLowerCase();\nif (HIGH_VALUE_INDUSTRIES.some(i => industryLower.includes(i))) {\n  score += 40;\n  reasons.push(`high-value industry: ${lead.industry} (+40)`);\n} else if (MED_VALUE_INDUSTRIES.some(i => industryLower.includes(i))) {\n  score += 20;\n  reasons.push(`medium-value industry: ${lead.industry} (+20)`);\n} else {\n  score += 5;\n  reasons.push(`other industry: ${lead.industry} (+5)`);\n}\n\n// Source bonus\nif (lead.source === 'whatsapp') {\n  score += 10;\n  reasons.push('WhatsApp inbound (+10)');\n} else if (lead.source === 'gmail') {\n  score += 5;\n  reasons.push('Gmail inbound (+5)');\n}\n\n\nlet _needsReview = false;\nif (!lead.companySize || lead.companySize === 0) {\n  score = Math.max(score - 10, 0);\n  _needsReview = true;\n  reasons.push('unknown company size — flagged for review (-10)');\n}\n\nreturn [{ json: { ...lead, _score: score, _scoreReasons: reasons, _needsReview } }];"
      },
