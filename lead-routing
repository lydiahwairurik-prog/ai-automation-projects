    {
      "parameters": {
        "jsCode": "const lead = $input.first().json;\n\nconst name = (lead.name || lead.fullName || lead.contact_name || '').trim();\nconst email = (lead.email || lead.email_address || '').toLowerCase().trim();\nconst company = (lead.company || lead.company_name || lead.organisation || '').trim();\nconst industry = (lead.industry || lead.sector || 'Unknown').trim();\nconst companySize = parseInt(lead.companySize || lead.company_size || lead.employees || 0, 10);\nconst source = lead.source || 'unknown';\nconst phone = lead.phone || lead.phoneNumber || null;\nconst message = lead.message || lead.body || '';\n\nconst errors = [];\nif (!name) errors.push('missing name');\nif (!email && !phone) errors.push('missing both email and phone');\nif (!company) errors.push('missing company');\n\nif (errors.length > 0) {\n  return [{\n    json: {\n      _valid: false,\n      _errors: errors,\n      raw: lead,\n      source\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    _valid: true,\n    name,\n    email,\n    company,\n    industry,\n    companySize,\n    source,\n    phone,\n    message,\n    receivedAt: new Date().toISOString()\n  }\n}];"
