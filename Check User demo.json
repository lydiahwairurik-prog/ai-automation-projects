        "jsCode": "const body = $input.first().json.body;\nconst { name, email } = body;\n\nif (!name || !email ) {\n  throw new Error('VALIDATION_ERROR: Missing required fields');\n}\n\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n  throw new Error('VALIDATION_ERROR: Invalid email format');\n}\n\nreturn [{ json: { name: name.trim(), email: email.toLowerCase().trim(), submittedAt: new Date().toISOString() } }];"
